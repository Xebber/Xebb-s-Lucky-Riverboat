// Helper: resolve outcome with house edge per game
function resolveGame(game, wager) {
  // All RTP < 100% (house edge > 0)
    switch (game.toLowerCase()) {
	    case 'keno':
		      // 25% chance to 4x, 15% chance to 2x, else lose
			        // RTP = 0.25*4 + 0.15*2 = 1.3 (too high) -> adjust
					      // Let's do: 15% * 4x, 20% * 2x => 0.15*4 + 0.20*2 = 1.0
						        // Then shave: 14% * 4x, 19% * 2x => 0.14*4 + 0.19*2 = 0.98 (2% edge)
								      {
									          const r = Math.random();
											          if (r < 0.14) return { win: true, payout: wager * 4 };
													          if (r < 0.14 + 0.19) return { win: true, payout: wager * 2 };
															          return { win: false, payout: 0 };
																	        }

																			    case 'crash':
																				      // Simple crash: 60% lose, 30% 1.5x, 10% 3x
																					        // RTP = 0.3*1.5 + 0.1*3 = 0.45 + 0.3 = 0.75 (25% edge)
																							      {
																								          const r = Math.random();
																										          if (r < 0.10) return { win: true, payout: wager * 3 };
																												          if (r < 0.10 + 0.30) return { win: true, payout: wager * 1.5 };
																														          return { win: false, payout: 0 };
																																        }

																																		    case 'plinko':
																																			      // Plinko style: many small hits, rare big
																																				        // 40% 1.2x, 10% 2x, 2% 5x
																																						      // RTP = 0.4*1.2 + 0.1*2 + 0.02*5 = 0.48 + 0.2 + 0.1 = 0.78
																																							        {
																																									        const r = Math.random();
																																											        if (r < 0.02) return { win: true, payout: wager * 5 };
																																													        if (r < 0.02 + 0.10) return { win: true, payout: wager * 2 };
																																															        if (r < 0.02 + 0.10 + 0.40) return { win: true, payout: wager * 1.2 };
																																																	        return { win: false, payout: 0 };
																																																			      }

																																																				      case 'hi-lo':
																																																					        // Assume player always guesses one step; we bake edge in:
																																																							      // 48% win 2x, 52% lose => RTP = 0.48*2 = 0.96 (4% edge)
																																																								        {
																																																										        const r = Math.random();
																																																												        if (r < 0.48) return { win: true, payout: wager * 2 };
																																																														        return { win: false, payout: 0 };
																																																																      }

																																																																	      case 'tower':
																																																																		        // Tower: medium volatility
																																																																				      // 20% 3x, 10% 5x, 5% 10x
																																																																					        // RTP = 0.2*3 + 0.1*5 + 0.05*10 = 0.6 + 0.5 + 0.5 = 1.6 (too high)
																																																																							      // Scale down: 10% 3x, 5% 5x, 2% 10x
																																																																								        // RTP = 0.1*3 + 0.05*5 + 0.02*10 = 0.3 + 0.25 + 0.2 = 0.75
																																																																										      {
																																																																											          const r = Math.random();
																																																																													          if (r < 0.02) return { win: true, payout: wager * 10 };
																																																																															          if (r < 0.02 + 0.05) return { win: true, payout: wager * 5 };
																																																																																	          if (r < 0.02 + 0.05 + 0.10) return { win: true, payout: wager * 3 };
																																																																																			          return { win: false, payout: 0 };
																																																																																					        }

																																																																																							    default:
																																																																																								      // Fallback: 45% 2x, 55% lose => RTP = 0.9
																																																																																									        {
																																																																																											        const r = Math.random();
																																																																																													        if (r < 0.45) return { win: true, payout: wager * 2 };
																																																																																															        return { win: false, payout: 0 };
																																																																																																	      }
																																																																																																		    }
																																																																																																			}

																																																																																																			app.post('/api/play', (req, res) => {
																																																																																																			  const { username, password, game, wager } = req.body;
																																																																																																			    const user = authenticate(username, password);
																																																																																																				  if (!user) return res.status(401).json({ error: 'Invalid credentials' });

																																																																																																				    const bet = Number(wager);
																																																																																																					  if (isNaN(bet) || bet <= 0) return res.status(400).json({ error: 'Invalid wager' });
																																																																																																					    if (bet > user.balance) return res.status(400).json({ error: 'Insufficient balance' });

																																																																																																						  user.balance -= bet;

																																																																																																						    const outcome = resolveGame(game || 'generic', bet);
																																																																																																							  if (outcome.win) {
																																																																																																							      user.balance += outcome.payout;
																																																																																																								    }

																																																																																																									  user.stats.gamesPlayed += 1;
																																																																																																									    user.stats.totalWagered += bet;
																																																																																																										  user.stats.totalWon += outcome.payout;

																																																																																																										    res.json({
																																																																																																											    game,
																																																																																																												    win: outcome.win,
																																																																																																													    wager: bet,
																																																																																																														    payout: outcome.payout,
																																																																																																															    balance: user.balance,
																																																																																																																    stats: user.stats
																																																																																																																	  });
																																																																																																																	  });